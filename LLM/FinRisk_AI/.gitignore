# FinRisk AI — gitignore

# ── Secrets (KHÔNG BAO GIỜ commit) ──────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# ── Data & Checkpoints (dữ liệu local, không cần version control) ────────────
data/
*.sqlite
*.db

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
