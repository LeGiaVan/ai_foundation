# Biến môi trường cho FinRisk AI
# Copy file này thành .env và điền giá trị thực.
# KHÔNG COMMIT .env lên Git! (Đã có trong .gitignore)

# ── LLM Provider ────────────────────────────────────────────────────────────
# Phase học (dùng Groq miễn phí): Đăng ký tại https://console.groq.com
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_xxxx
GROQ_MODEL=openai/gpt-oss-120b

# Phase production (uncomment khi sẵn sàng trả tiền)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxx
# LLM_MODEL=claude-3-5-haiku-20241022

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ── LangGraph ────────────────────────────────────────────────────────────────
CHECKPOINTER_DB_PATH=./data/checkpoints.sqlite
MAX_AGENT_ITERATIONS=10

# ── Ngưỡng nghiệp vụ (có thể override theo chính sách từng ngân hàng) ────────
ZSCORE_DISTRESS_THRESHOLD=1.81
DSCR_MINIMUM=1.0
DEBT_EQUITY_MAX=3.0
QUICK_RATIO_MINIMUM=0.8
RISK_SCORE_REJECT_THRESHOLD=70.0
RISK_SCORE_REVIEW_THRESHOLD=40.0

# ── Langfuse Observability (Phase 3 — bỏ comment khi sẵn sàng) ──────────────
# LANGFUSE_SECRET_KEY=sk-lf-xxxx
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
# LANGFUSE_HOST=http://localhost:3000
# ENABLE_TRACING=true

# ── Qdrant Vector DB (Phase 2 — bỏ comment khi sẵn sàng) ────────────────────
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_COLLECTION=financial_docs

# ── Môi trường ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
